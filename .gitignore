# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files (often contain sensitive values)
*.tfvars
*.tfvars.json

# Terraform plan files
*.tfplan
*.tfplan.*

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Local secret files (at any directory depth)
.secrets
.secrets.*
!.secrets.example
